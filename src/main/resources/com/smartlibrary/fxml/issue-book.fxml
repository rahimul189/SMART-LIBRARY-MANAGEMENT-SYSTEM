<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- Step 11 - Admin: Issue Book. Standalone screen - only issuing a book is possible here.
     The form is a fixed-width white card centred in the content area, so the fields
     never stretch across a very wide window. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.smartlibrary.controller.IssueBookController"
      spacing="16" prefWidth="440" maxWidth="520" styleClass="login-card">
    <padding>
        <Insets top="26" right="26" bottom="26" left="26"/>
    </padding>

    <Label text="Issue Book" styleClass="page-title"/>

    <VBox spacing="6">
        <Label text="Select Student" styleClass="section-title"/>
        <ComboBox fx:id="studentComboBox" promptText="Student..." maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Select Book" styleClass="section-title"/>
        <ComboBox fx:id="bookComboBox" promptText="Available book..." maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Issue Date" styleClass="section-title"/>
        <DatePicker fx:id="issueDatePicker" maxWidth="Infinity"/>
    </VBox>

    <Button text="Issue Book" styleClass="btn-success" maxWidth="Infinity" onAction="#handleIssue"/>

    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true"/>
</VBox>
