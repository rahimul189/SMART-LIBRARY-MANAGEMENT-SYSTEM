<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartlibrary.controller.StudentDashboardController"
            fx:id="rootPane"
            styleClass="content-pane">

    <!-- Application menu bar. It lives on the dashboard itself, so it stays on
         top of every sub screen loaded into the center. The Account menu is the
         student-only part: admins use the same bar without it (see
         admin-dashboard.fxml). -->
    <top>
        <MenuBar fx:id="appMenuBar">
            <menus>
                <Menu text="File">
                    <items>
                        <MenuItem text="Exit" onAction="#handleExit"/>
                    </items>
                </Menu>
                <Menu text="View">
                    <items>
                        <MenuItem fx:id="fullScreenMenuItem" text="Full Screen"
                                  onAction="#handleFullScreen"/>
                        <MenuItem text="Reset View" onAction="#handleResetView"/>
                    </items>
                </Menu>
                <Menu text="Account">
                    <items>
                        <MenuItem text="My Profile" onAction="#handleAccountProfile"/>
                        <MenuItem text="Change Password" onAction="#handleChangePassword"/>
                    </items>
                </Menu>
                <Menu text="Help">
                    <items>
                        <MenuItem text="User Guide" onAction="#handleUserGuide"/>
                        <MenuItem text="About" onAction="#handleAbout"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <left>
        <VBox fx:id="sidebar" spacing="6" alignment="TOP_CENTER" styleClass="sidebar" prefWidth="200" minWidth="190">
            <padding>
                <Insets top="20" bottom="12" left="15" right="15"/>
            </padding>

            <!-- Circular profile image (filled by handleChooseAvatar). -->
            <StackPane prefWidth="76" prefHeight="76" styleClass="avatar-frame">
                <Circle radius="36" styleClass="avatar-icon"/>
                <ImageView fx:id="avatarImageView" fitWidth="72" fitHeight="72" mouseTransparent="true"/>
                <Circle radius="35" fill="TRANSPARENT" stroke="#d9ffffff"
                       style="-fx-stroke-width: 3;" mouseTransparent="true"/>
            </StackPane>
            <Button text="Choose File" styleClass="avatar-choose-button" onAction="#handleChooseAvatar"/>

            <Label text="Welcome" styleClass="welcome-label">
                <VBox.margin>
                    <Insets top="4"/>
                </VBox.margin>
            </Label>
            <Label fx:id="studentNameLabel" styleClass="student-number-label"/>

            <VBox spacing="8" alignment="CENTER" maxWidth="Infinity">
                <padding>
                    <Insets top="10"/>
                </padding>
                <Button fx:id="navDashboard" text="Dashboard" styleClass="nav-button" maxWidth="Infinity" onAction="#showDashboard"/>
                <Button fx:id="navAvailable" text="Available Books" styleClass="nav-button" maxWidth="Infinity" onAction="#showAvailableBooks"/>
                <Button fx:id="navBorrowed" text="My Borrowed Books" styleClass="nav-button" maxWidth="Infinity" onAction="#showBorrowedBooks"/>
                <Button fx:id="navHistory" text="Borrowing History" styleClass="nav-button" maxWidth="Infinity" onAction="#showHistory"/>
            </VBox>

            <!-- Flexible spacer: keeps Logout pinned to the bottom-left corner
                 at any window size, without ever overlapping the nav buttons. -->
            <Region minWidth="0" minHeight="0" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>

            <Button text="Logout" styleClass="logout-button" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <center>
        <!-- The profile page lives inside a ScrollPane: on a short window the
             card scrolls instead of being cut off at the bottom. fitToWidth
             makes the content take the full window width, and the GridPane
             below splits that width with percentage-based columns. -->
        <ScrollPane fx:id="profileScrollPane" fitToWidth="true" styleClass="content-pane"
                    BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="profileView" alignment="TOP_LEFT" spacing="18" styleClass="content-pane" minWidth="0">
                    <padding>
                        <Insets top="30" left="30" right="30" bottom="30"/>
                    </padding>

                    <!-- Read-only profile header: the picture (no "Choose File"
                         here - the avatar is changed from the sidebar) next to
                         the page title, then the details card below. -->
                    <HBox spacing="18" alignment="CENTER_LEFT">
                        <StackPane prefWidth="96" prefHeight="96" styleClass="avatar-frame">
                            <Circle radius="46" styleClass="avatar-icon"/>
                            <ImageView fx:id="profileImageView" fitWidth="90" fitHeight="90"
                                       mouseTransparent="true"/>
                            <Circle radius="45" fill="TRANSPARENT" stroke="#d9ffffff"
                                   style="-fx-stroke-width: 4;" mouseTransparent="true"/>
                        </StackPane>
                        <VBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="My Profile" styleClass="page-title"/>
                            <Label text="Your account details as they are stored in the library records."
                                   styleClass="page-subtitle" wrapText="true"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="login-card" spacing="0" maxWidth="640">
                        <padding>
                            <Insets top="24" right="26" bottom="24" left="26"/>
                        </padding>

                        <!-- Percentage-based columns: the label column always
                             takes 35% of the card and the value column 65%,
                             whatever the window size (minWidth keeps the
                             labels readable when the card gets very narrow),
                             and the value labels wrap instead of clipping. -->
                        <GridPane hgap="14" vgap="14" maxWidth="Infinity">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="35" minWidth="120"/>
                                <ColumnConstraints percentWidth="65"/>
                            </columnConstraints>

                            <Label text="Student ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="section-title" wrapText="true"/>
                            <Label fx:id="studentIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" wrapText="true"/>

                            <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="section-title" wrapText="true"/>
                            <Label fx:id="nameLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" wrapText="true"/>

                            <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="section-title" wrapText="true"/>
                            <Label fx:id="emailLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" wrapText="true"/>

                            <Label text="Department:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="section-title" wrapText="true"/>
                            <Label fx:id="departmentLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" wrapText="true"/>

                            <Label text="Phone:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="section-title" wrapText="true"/>
                            <Label fx:id="phoneLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" wrapText="true"/>

                            <Label text="Gender:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="section-title" wrapText="true"/>
                            <Label fx:id="genderLabel" GridPane.rowIndex="5" GridPane.columnIndex="1" wrapText="true"/>
                        </GridPane>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
